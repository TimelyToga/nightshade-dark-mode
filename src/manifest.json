{
  "manifest_version": 3,
  "name": "Nightshade — Dark Mode Anywhere",
  "version": "0.1.0",
  "description": "A gentle, reversible dark mode for websites that do not provide one.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_title": "Nightshade",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["content.css"],
      "js": ["media.js", "content.js"],
      "run_at": "document_start",
      "all_frames": false,
      "match_origin_as_fallback": true
    }
  ]
}
